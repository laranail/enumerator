* text=auto eol=lf

# Files/dirs excluded from Packagist archives
/tests              export-ignore
/docs               export-ignore
/examples           export-ignore
/.github            export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.idea              export-ignore
/.vscode            export-ignore
/CHANGELOG.md       export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/plans              export-ignore
/SECURITY.md        export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/scripts            export-ignore

# NOT export-ignored, despite looking like a dev file: composer.json declares
# `extra.phpstan.includes: ["extension.neon"]`, and phpstan/extension-installer
# writes that path into every consumer's generated config. Stripping it from the
# dist archive made PHPStan fail hard for anyone who installed this package —
# "Config file .../vendor/laranail/enumerator/extension.neon does not exist or
# isn't readable" — with nothing pointing back here as the cause.
#
# /extension.neon   export-ignore

# Language detection on GitHub
*.blade.php linguist-language=Blade
*.stub      linguist-language=PHP
